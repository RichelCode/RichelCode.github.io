---
import Layout from "../layouts/Layout.astro";
import HandUnderline from "../components/HandUnderline.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Band from "../components/Band.astro";
import MailerLiteForm from "../components/MailerLiteForm.astro";
import Icon from "../components/Icon.astro";
import {
  site,
  assets,
  socials,
  FREEBIE_GROUP,
  MAILERLITE_FREEBIE_ACTION,
} from "../data/site";

const learn = [
  "What RAG actually is, explained without the jargon",
  "Why RAG matters and where it's used in the real world",
  "The core pieces of a RAG system and how they fit together",
  "How retrieval works (embeddings and vector search, made simple)",
  "How to connect retrieval to a language model for grounded answers",
  "A step-by-step walkthrough of building your first RAG assistant",
  "Common mistakes and how to avoid them",
  "How to evaluate whether your RAG system is actually working",
  "Where to go next to keep building",
];

const formProps = {
  group: FREEBIE_GROUP,
  action: MAILERLITE_FREEBIE_ACTION,
  withName: true,
  buttonLabel: "Send me the guide",
  placeholder: "Your best email",
};
---

<Layout
  title="Free RAG Ebook"
  description="Grab my free guide, A Practical Introduction to RAG: Build Your First AI Assistant. Learn how Retrieval-Augmented Generation works, in plain English."
  image={assets.ebookCover}
>
  <!-- ░░ Hero ░░ -->
  <section class="relative overflow-hidden pt-32 pb-12 sm:pt-40 sm:pb-16">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -left-24 top-24 h-96 w-96 rounded-full bg-sky/40 blur-3xl"></div>
      <div class="absolute right-[-6rem] top-40 h-80 w-80 rounded-full bg-gold/15 blur-3xl"></div>
    </div>

    <div class="container-page">
      <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <!-- Cover: real cover art as the face of a tilted 3D book -->
        <div class="reveal order-1">
          <div class="relative mx-auto w-72 [perspective:1800px] sm:w-[23rem]">
            <!-- soft ground shadow -->
            <div class="absolute -bottom-9 left-1/2 h-12 w-[85%] -translate-x-1/2 rounded-[50%] bg-navy/35 blur-3xl"></div>

            <div class="group relative transition-transform duration-700 ease-out [transform:perspective(1800px)_rotateY(-19deg)_rotateX(4deg)] hover:[transform:perspective(1800px)_rotateY(-9deg)_rotateX(2deg)]">
              <!-- page block behind the cover to fake paper thickness -->
              <div class="absolute inset-0 translate-x-[16px] rounded-xl rounded-l-sm bg-gradient-to-r from-[#d9cdb4] via-[#f0e9d9] to-[#efe8d8] shadow-[0_40px_80px_-30px_rgba(12,42,74,0.6)]"></div>

              <!-- front cover (the real cover image, no distortion) -->
              <img
                src={assets.ebookCover}
                alt="Cover of the free ebook, A Practical Introduction to RAG: Build Your First AI Assistant"
                class="relative block aspect-[17/22] w-full rounded-xl rounded-l-sm object-cover object-center shadow-[0_45px_90px_-25px_rgba(12,42,74,0.65)] ring-1 ring-black/10"
                onerror="this.onerror=null; this.src='/images/rag-ebook-cover.svg'"
              />

              <!-- spine shadow on the binding edge -->
              <div class="pointer-events-none absolute inset-y-0 left-0 w-8 rounded-l-sm bg-gradient-to-r from-black/40 via-black/12 to-transparent"></div>
              <!-- subtle light sheen -->
              <div class="pointer-events-none absolute inset-0 rounded-xl rounded-l-sm bg-gradient-to-tr from-transparent via-transparent to-white/20"></div>
            </div>

            <span class="absolute -right-5 -top-5 rotate-6 rounded-full bg-gold px-5 py-2 text-base font-bold text-[#3d2a06] shadow-[0_14px_30px_-8px_rgba(232,162,61,0.8)]">
              100% free
            </span>
          </div>
        </div>

        <!-- Copy + form -->
        <div class="order-2">
          <span class="reveal eyebrow">free guide</span>
          <h1 class="reveal mt-2 text-4xl font-semibold leading-[1.08] sm:text-5xl" data-delay="40">
            A Practical Introduction to
            <span class="relative inline-block whitespace-nowrap text-blue">
              RAG
              <HandUnderline class="absolute -bottom-2 left-0 h-5 w-full" color="blue" width={7} />
            </span>
          </h1>
          <p class="reveal mt-3 font-display text-xl text-navy/80" data-delay="80">
            Build your first AI assistant.
          </p>

          <p class="reveal mt-6 max-w-md text-lg leading-relaxed text-ink/90" data-delay="120">
            Not ready to work together yet? No problem. Grab my free guide to
            building your first AI assistant.
          </p>
          <p class="reveal mt-3 max-w-md leading-relaxed text-muted" data-delay="160">
            A plain-English walkthrough of how Retrieval-Augmented Generation
            works, and how to build a RAG system from scratch.
          </p>

          <!-- Email capture (hero) -->
          <div class="reveal mt-7 max-w-md" data-delay="200">
            <MailerLiteForm {...formProps} />
            <p class="mt-3 flex items-center gap-2 text-xs text-muted">
              <Icon name="check" class="h-4 w-4 text-blue" />
              No spam. I'll email you the guide and the occasional useful thing.
            </p>
            <!-- TODO (ebook delivery): set up a MailerLite automation that emails the
                 download link to anyone who joins the "freebie-rag-ebook" group.
                 Paste the PDF link into EBOOK_DOWNLOAD_URL in src/data/site.ts. -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ What you'll learn ░░ -->
  <Band color="cream-deep">
    <section class="section">
      <div class="container-page">
        <SectionTitle eyebrow="inside the guide" title="What you'll learn" underline="learn" color="blue">
          <p class="mt-5 max-w-xl text-pretty leading-relaxed text-muted">
            By the end, you'll understand how RAG works and have built your first
            AI assistant, step by step.
          </p>
        </SectionTitle>

        <ol class="mt-12 grid gap-4 sm:grid-cols-2">
          {learn.map((item, i) => (
            <li class="reveal card flex items-start gap-4 p-5" data-delay={`${(i % 2) * 70}`}>
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-navy font-display text-sm font-semibold text-white">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="pt-1 leading-relaxed text-ink/90">{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </Band>

  <!-- ░░ Who this is for ░░ -->
  <section class="section">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">is this you?</span>
        <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">
          Who this is
          <span class="relative inline-block whitespace-nowrap text-blue">
            for
            <HandUnderline class="absolute -bottom-2 left-0 h-4 w-full" color="sky" width={6} />
          </span>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-ink/90">
          This guide is for developers, data scientists, and curious learners who
          want to build practical AI, not just read about it. If you can write a
          little Python and you're excited to make a language model actually
          useful with your own data, you're exactly who I wrote this for. No
          machine-learning PhD required.
        </p>
      </div>
    </div>
  </section>

  <!-- ░░ Credibility ░░ -->
  <Band color="cream-deep">
    <section class="section">
      <div class="container-page">
        <div class="mx-auto flex max-w-3xl flex-col items-center gap-8 sm:flex-row sm:gap-10">
          <div class="reveal shrink-0">
            <div class="relative w-44 sm:w-52">
              <div class="absolute inset-0 rotate-3 rounded-[1.75rem] border-2 border-sky"></div>
              <img
                src={assets.headshot}
                alt={`Portrait of ${site.name}`}
                class="relative aspect-square w-full rounded-[1.75rem] border-4 border-white object-cover shadow-[var(--shadow-lift)]"
                onerror="this.src='/images/headshot-placeholder.svg'"
              />
            </div>
          </div>
          <div class="reveal text-center sm:text-left" data-delay="80">
            <span class="font-hand text-2xl text-blue">why learn this from me</span>
            <h3 class="mt-1 font-display text-2xl font-semibold text-navy">Hi, I'm Richel</h3>
            <p class="mt-3 leading-relaxed text-ink/90">
              I build production RAG systems and AI assistants for clients and
              research, the same techniques this guide teaches. I'm also an
              educator who has taught hundreds of students, so my whole focus is
              making this stuff genuinely easy to understand. I wrote the guide I
              wish I'd had when I started.
            </p>
          </div>
        </div>
      </div>
    </section>
  </Band>

  <!-- ░░ Final CTA ░░ -->
  <section class="section">
    <div class="container-page">
      <div class="reveal relative overflow-hidden rounded-[2.25rem] bg-navy px-6 py-14 text-white sm:px-12 sm:py-16">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-blue/30 blur-3xl"></div>
          <div class="absolute -bottom-20 -left-10 h-64 w-64 rounded-full bg-sky/20 blur-3xl"></div>
        </div>
        <div class="relative mx-auto max-w-xl text-center">
          <span class="grid mx-auto h-14 w-14 place-items-center rounded-2xl bg-white/10 text-sky">
            <Icon name="spark" class="h-7 w-7" />
          </span>
          <h2 class="mt-6 text-3xl font-semibold text-white sm:text-4xl">
            Ready to build your first
            <span class="relative inline-block whitespace-nowrap text-sky">
              AI assistant?
              <HandUnderline class="absolute -bottom-2 left-0 h-4 w-full" color="sky" width={6} />
            </span>
          </h2>
          <p class="mx-auto mt-4 max-w-md text-white/75">
            Drop your email and I'll send the guide your way. It's free, and it's
            the fastest path from curious to building.
          </p>

          <div class="mx-auto mt-8 max-w-md text-left">
            <MailerLiteForm {...formProps} />
            <p class="mt-3 text-center text-xs text-white/55">
              Join the readers learning to build with AI. Unsubscribe anytime.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
