---
import Layout from "../layouts/Layout.astro";
import HandUnderline from "../components/HandUnderline.astro";
import ProjectCard from "../components/ProjectCard.astro";
import NewsletterCTA from "../components/NewsletterCTA.astro";
import Icon from "../components/Icon.astro";
import { projects } from "../data/projects";
---

<Layout title="Projects" description="Featured AI/ML and data science projects by Richel Attafuah — forecasting, RAG, multi-agent systems, and predictive ML.">
  <section class="pt-32 pb-10 sm:pt-40">
    <div class="container-page">
      <span class="reveal eyebrow">things I've built</span>
      <h1 class="reveal mt-2 max-w-3xl text-4xl font-semibold leading-[1.05] sm:text-5xl md:text-6xl" data-delay="40">
        Featured
        <span class="relative inline-block whitespace-nowrap text-blue">
          projects
          <HandUnderline class="absolute -bottom-2 left-0 h-5 w-full" color="sky" width={7} />
        </span>
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-muted" data-delay="100">
        A selection of systems across forecasting, RAG, multi-agent tooling, and
        predictive ML. Demos and write-ups are being added — check back as I
        publish more.
      </p>
    </div>
  </section>

  <section class="pb-8">
    <div class="container-page">
      <div class="grid gap-7 lg:grid-cols-2">
        {projects.map((p, i) => <ProjectCard project={p} delay={(i % 2) * 90} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="reveal card flex flex-col items-center gap-4 p-10 text-center">
        <span class="grid h-14 w-14 place-items-center rounded-2xl bg-sky-soft text-blue">
          <Icon name="briefcase" class="h-7 w-7" />
        </span>
        <h2 class="font-display text-2xl font-semibold text-navy">Want something like this built?</h2>
        <p class="max-w-md text-muted">I take on a small number of consulting projects. If one of these resonates, let's talk about yours.</p>
        <a href="/work" class="btn btn-primary mt-2">Work with me <Icon name="arrowRight" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <NewsletterCTA group="newsletter" />
</Layout>
