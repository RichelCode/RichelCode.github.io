---
import Layout from "../layouts/Layout.astro";
import HandUnderline from "../components/HandUnderline.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.tsx";
import { site, socials } from "../data/site";

const social = [
  { name: "github", href: socials.github, label: "GitHub" },
  { name: "linkedin", href: socials.linkedin, label: "LinkedIn" },
  { name: "medium", href: socials.medium, label: "Medium" },
  { name: "youtube", href: socials.youtube, label: "YouTube" },
  { name: "email", href: socials.email, label: "Email" },
];
---

<Layout title="Contact" description="Get in touch with Richel Attafuah — for consulting, collaborations, research, or just to say hello.">
  <section class="pt-32 pb-16 sm:pt-40">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
        <!-- Left: pitch + links -->
        <div>
          <span class="reveal eyebrow">say hello</span>
          <h1 class="reveal mt-2 text-4xl font-semibold leading-[1.05] sm:text-5xl" data-delay="40">
            Let's
            <span class="relative inline-block whitespace-nowrap text-blue">
              talk
              <HandUnderline class="absolute -bottom-2 left-0 h-5 w-full" color="sky" width={7} />
            </span>
          </h1>
          <p class="reveal mt-6 max-w-md text-lg leading-relaxed text-muted" data-delay="100">
            Have a project, a role, a research question, or just want to connect?
            Fill out the form and I'll get back to you. I read every message.
          </p>

          <a href={socials.email} class="reveal mt-8 inline-flex items-center gap-2 font-display text-xl font-semibold text-navy transition-colors hover:text-blue" data-delay="140">
            <Icon name="email" class="h-6 w-6 text-blue" />
            {site.email}
          </a>

          <div class="reveal mt-8" data-delay="180">
            <p class="font-hand text-xl text-blue">find me online</p>
            <div class="mt-3 flex flex-wrap gap-2.5">
              {social.map((s) => (
                <a href={s.href} target={s.name === "email" ? undefined : "_blank"} rel="noopener noreferrer" aria-label={s.label} class="grid h-11 w-11 place-items-center rounded-full border border-border bg-white text-muted transition-all hover:-translate-y-0.5 hover:border-blue hover:text-blue">
                  <Icon name={s.name} />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: Formspree React form -->
        <div class="reveal card p-7 sm:p-9" data-delay="120">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</Layout>
