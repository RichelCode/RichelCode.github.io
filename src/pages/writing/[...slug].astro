---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import NewsletterCTA from "../../components/NewsletterCTA.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title={post.data.title} description={post.data.description} path={`/writing/${post.id}`}>
  <article class="pt-32 pb-16 sm:pt-40">
    <div class="container-prose">
      <a href="/writing" class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-blue">
        <Icon name="arrowRight" class="h-4 w-4 rotate-180" /> All writing
      </a>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-muted">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        {post.data.tags.map((t) => <span class="chip">#{t}</span>)}
      </div>

      <h1 class="mt-4 text-3xl font-semibold leading-[1.1] text-navy sm:text-4xl md:text-5xl">{post.data.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{post.data.description}</p>
      {post.data.updatedDate && <p class="mt-3 text-xs italic text-muted">Updated {fmt(post.data.updatedDate)}</p>}

      <div class="prose-richel mt-10">
        <Content />
      </div>
    </div>
  </article>

  <NewsletterCTA group="newsletter" />
</Layout>

<style is:global>
  .prose-richel { color: var(--color-ink); font-size: 1.075rem; line-height: 1.8; }
  .prose-richel > * + * { margin-top: 1.4em; }
  .prose-richel h2 { font-family: var(--font-display); color: var(--color-navy); font-size: 1.7rem; font-weight: 600; line-height: 1.2; margin-top: 2.2em; letter-spacing: -0.02em; }
  .prose-richel h3 { font-family: var(--font-display); color: var(--color-navy); font-size: 1.3rem; font-weight: 600; margin-top: 1.8em; }
  .prose-richel a { color: var(--color-blue); text-decoration: underline; text-underline-offset: 3px; }
  .prose-richel strong { color: var(--color-navy); font-weight: 600; }
  .prose-richel ul, .prose-richel ol { padding-left: 1.4em; }
  .prose-richel ul { list-style: disc; }
  .prose-richel ol { list-style: decimal; }
  .prose-richel li { margin-top: 0.5em; }
  .prose-richel li::marker { color: var(--color-blue); }
  .prose-richel blockquote { border-left: 3px solid var(--color-sky); padding: 0.2em 0 0.2em 1.2em; font-style: italic; color: var(--color-muted); }
  .prose-richel code { font-family: var(--font-mono); font-size: 0.875em; background: #f1ece1; padding: 0.15em 0.4em; border-radius: 6px; }
  .prose-richel pre { background: var(--color-navy); color: #eef4fb; border-radius: var(--radius-xl); padding: 1.25rem; overflow-x: auto; }
  .prose-richel pre code { background: transparent; padding: 0; color: inherit; }
  .prose-richel img { border-radius: var(--radius-xl); border: 1px solid var(--color-border); }
  .prose-richel hr { border: none; border-top: 1px solid var(--color-border); }
</style>
