---
import Layout from "../layouts/Layout.astro";
import HandUnderline from "../components/HandUnderline.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Band from "../components/Band.astro";
import SocialProof from "../components/SocialProof.astro";
import Icon from "../components/Icon.astro";
import { services, audiences, process } from "../data/services";
---

<Layout title="Work With Me" description="Hire Richel for AI/ML solutions, RAG systems, forecasting, data science consulting, research support, and training.">
  <!-- Hero -->
  <section class="pt-32 pb-10 sm:pt-40">
    <div class="container-page text-center">
      <span class="reveal eyebrow justify-center">let's build something</span>
      <h1 class="reveal mx-auto mt-2 max-w-3xl text-4xl font-semibold leading-[1.05] sm:text-5xl md:text-6xl" data-delay="40">
        Work
        <span class="relative inline-block whitespace-nowrap text-blue">
          with me
          <HandUnderline class="absolute -bottom-2 left-0 h-5 w-full" color="sky" width={7} />
        </span>
      </h1>
      <p class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted" data-delay="100">
        Whether you have a clear ML problem or just a hunch that AI could help, I
        help you scope it, build it, and ship it, without the hype.
      </p>
      <div class="reveal mt-8 flex flex-wrap justify-center gap-3" data-delay="160">
        <a href="/contact" class="btn btn-primary">Book a call <Icon name="arrowRight" class="h-4 w-4" /></a>
        <a href="/projects" class="btn btn-secondary">See my work</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container-page">
      <SectionTitle eyebrow="how I can help" title="What I offer" underline="offer" color="blue">
        <p class="mt-5 max-w-xl text-pretty leading-relaxed text-muted">
          A focused set of services across the full lifecycle, from first idea
          to a system running in the real world.
        </p>
      </SectionTitle>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <article class="reveal card card-hover group flex flex-col p-7" data-delay={`${(i % 3) * 80}`}>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-sky-soft text-blue transition-transform duration-300 group-hover:-rotate-6">
              <Icon name={s.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 font-display text-xl font-semibold text-navy">{s.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{s.blurb}</p>
            <ul class="mt-5 space-y-2 border-t border-border pt-5">
              {s.bullets.map((b) => (
                <li class="flex items-start gap-2.5 text-sm text-muted">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-blue" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <Band color="cream-deep">
    <section class="section">
      <div class="container-page">
        <SectionTitle eyebrow="is this you?" title="Who I work with" underline="with" align="center" color="gold" variant={1} />
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {audiences.map((a, i) => (
            <div class="reveal card flex flex-col items-center p-8 text-center" data-delay={`${i * 90}`}>
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-navy text-white">
                <Icon name={a.icon} class="h-7 w-7" />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold text-navy">{a.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{a.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </Band>

  <!-- How it works -->
  <section class="section">
    <div class="container-page">
      <SectionTitle eyebrow="the process" title="How it works" underline="works" color="blue" variant={2}>
        <p class="mt-5 max-w-xl text-pretty leading-relaxed text-muted">
          Simple, transparent, and collaborative. You're never left guessing
          where things stand.
        </p>
      </SectionTitle>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {process.map((p, i) => (
          <div class="reveal card relative flex flex-col p-7" data-delay={`${(i % 4) * 70}`}>
            <span class="font-display text-4xl font-semibold text-sky">{p.step}</span>
            <h3 class="mt-3 font-display text-lg font-semibold text-navy">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Band color="cream-deep">
    <SocialProof />
  </Band>

  <!-- CTA -->
  <section class="section">
    <div class="container-page">
      <div class="reveal relative overflow-hidden rounded-[2.25rem] bg-navy px-6 py-14 text-center text-white sm:px-12 sm:py-16">
        <div class="pointer-events-none absolute -right-12 -top-12 h-56 w-56 rounded-full bg-blue/30 blur-3xl"></div>
        <div class="relative mx-auto max-w-xl">
          <h2 class="text-3xl font-semibold text-white sm:text-4xl">
            Have a project in
            <span class="relative inline-block whitespace-nowrap text-sky">
              mind?
              <HandUnderline class="absolute -bottom-2 left-0 h-4 w-full" color="sky" width={6} />
            </span>
          </h2>
          <p class="mx-auto mt-4 max-w-md text-white/75">
            Tell me what you're working on. I'll get back to you, and we'll figure
            out if we're a good fit.
          </p>
          <a href="/contact" class="btn btn-gold mt-8">Book a call <Icon name="arrowRight" class="h-4 w-4" /></a>
        </div>
      </div>
    </div>
  </section>
</Layout>
