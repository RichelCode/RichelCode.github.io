---
import { navLinks, site } from "../data/site";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav class="container-page">
    <div
      id="nav-shell"
      class="mt-3 flex items-center justify-between gap-3 rounded-full border border-transparent py-2 pl-5 pr-2 transition-all duration-300"
    >
      <a href="/" class="group flex items-center gap-2.5 shrink-0">
        <span
          class="grid h-9 w-9 place-items-center rounded-full bg-navy font-display text-lg font-semibold text-white transition-transform duration-300 group-hover:-rotate-6"
          >R</span
        >
        <span class="font-display text-lg font-semibold text-navy">Richel</span>
      </a>

      <ul class="hidden items-center gap-0.5 lg:flex">
        {
          navLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class={`rounded-full px-3.5 py-2 text-sm font-medium transition-colors ${
                  isActive(l.href)
                    ? "bg-sky-soft text-blue"
                    : "text-muted hover:bg-sky-soft hover:text-navy"
                }`}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a href="/contact" class="btn btn-primary hidden !px-5 !py-2.5 !text-sm sm:inline-flex">
          Work with me
        </a>
        <button
          id="menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          class="grid h-10 w-10 place-items-center rounded-full border border-border bg-white text-navy lg:hidden"
        >
          <Icon name="menu" />
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="container-page grid max-h-0 overflow-hidden transition-all duration-300 lg:hidden"
  >
    <div class="mt-2 rounded-3xl border border-border bg-white p-3 shadow-[var(--shadow-lift)]">
      {
        [{ label: "Home", href: "/" }, ...navLinks].map((l) => (
          <a
            href={l.href}
            class="mobile-link block rounded-2xl px-4 py-3 text-base font-medium text-navy transition-colors hover:bg-sky-soft hover:text-blue"
          >
            {l.label}
          </a>
        ))
      }
      <a href="/contact" class="mobile-link btn btn-primary mt-2 w-full">Work with me</a>
    </div>
  </div>
</header>

<script>
  // Glass background after slight scroll
  const shell = document.getElementById("nav-shell");
  const onScroll = () => {
    const on = window.scrollY > 12;
    shell?.classList.toggle("border-border", on);
    shell?.classList.toggle("bg-[color-mix(in_oklab,var(--color-cream)_80%,transparent)]", on);
    shell?.classList.toggle("backdrop-blur-xl", on);
    shell?.classList.toggle("shadow-[0_8px_30px_-18px_rgba(12,42,74,0.3)]", on);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu
  const menuToggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  let open = false;
  const setMenu = (next: boolean) => {
    open = next;
    menu?.classList.toggle("max-h-0", !open);
    menu?.classList.toggle("max-h-[85vh]", open);
    menuToggle?.setAttribute("aria-expanded", String(open));
  };
  menuToggle?.addEventListener("click", () => setMenu(!open));
  document
    .querySelectorAll(".mobile-link")
    .forEach((a) => a.addEventListener("click", () => setMenu(false)));
</script>
