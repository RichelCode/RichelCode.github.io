---
import SectionTitle from "./SectionTitle.astro";
import ProjectCard from "./ProjectCard.astro";
import Icon from "./Icon.astro";
import { projects } from "../data/projects";

const featured = projects.filter((p) => p.featured).slice(0, 2);
---

<section class="section">
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionTitle eyebrow="a little taste" title="Featured projects" underline="projects" color="blue">
        <p class="mt-5 max-w-md text-pretty leading-relaxed text-muted">
          A few things I've built across forecasting, RAG, and applied ML. Each
          one went from idea to something that actually works.
        </p>
      </SectionTitle>
      <a href="/projects" class="reveal btn btn-secondary shrink-0" data-delay="120">
        See all projects <Icon name="arrowRight" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-12 grid gap-7 lg:grid-cols-2">
      {featured.map((p, i) => <ProjectCard project={p} delay={(i % 2) * 90} />)}
    </div>
  </div>
</section>
