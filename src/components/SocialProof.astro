---
import SectionTitle from "./SectionTitle.astro";
import { testimonials, credibility } from "../data/testimonials";

const initials = (name?: string) =>
  (name ?? "")
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
---

<section class="section">
  <div class="container-page">
    <!-- credibility strip -->
    <div class="reveal flex flex-wrap items-center justify-center gap-3">
      {credibility.map((c) => <span class="pill !bg-white">{c}</span>)}
    </div>

    <div class="mt-14">
      <SectionTitle
        eyebrow="kind words"
        title="What people say"
        underline="say"
        align="center"
        color="gold"
        variant={1}
      >
        <p class="mx-auto mt-5 max-w-xl text-pretty leading-relaxed text-muted">
          A little of what it's like to work and learn with me. More names and
          faces coming as I gather them.
        </p>
      </SectionTitle>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t, i) => (
          <figure class="reveal card relative flex flex-col p-7" data-delay={`${i * 90}`}>
            <div class="font-display text-5xl leading-none text-sky">“</div>
            <blockquote class="-mt-3 flex-1 text-pretty leading-relaxed text-ink/90">
              {t.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-border pt-5">
              {t.photo ? (
                <img src={t.photo} alt={t.name ?? "Testimonial"} class="h-11 w-11 rounded-full object-cover" loading="lazy" />
              ) : t.name ? (
                <span class="grid h-11 w-11 place-items-center rounded-full bg-sky-soft font-display text-sm font-semibold text-blue">
                  {initials(t.name)}
                </span>
              ) : (
                <span class="grid h-11 w-11 place-items-center rounded-full bg-sky-soft font-display text-2xl leading-none text-blue">
                  “
                </span>
              )}
              <div>
                {t.name && <p class="text-sm font-semibold text-navy">{t.name}</p>}
                {t.role && <p class="text-xs text-muted">{t.role}</p>}
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
