---
import Icon from "./Icon.astro";
import HandUnderline from "./HandUnderline.astro";
import MailerLiteForm from "./MailerLiteForm.astro";

interface Props {
  group?: string;
}
const { group = "newsletter" } = Astro.props;
---

<section class="section">
  <div class="container-page">
    <div class="reveal relative overflow-hidden rounded-[2.25rem] bg-navy px-6 py-14 text-white sm:px-12 sm:py-16">
      <!-- soft decorative blobs -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-blue/30 blur-3xl"></div>
        <div class="absolute -bottom-20 -left-10 h-64 w-64 rounded-full bg-sky/20 blur-3xl"></div>
      </div>

      <div class="relative mx-auto max-w-2xl text-center">
        <span class="grid mx-auto h-14 w-14 place-items-center rounded-2xl bg-white/10 text-sky">
          <Icon name="spark" class="h-7 w-7" />
        </span>
        <h2 class="mt-6 text-3xl font-semibold text-white sm:text-4xl">
          Let's
          <span class="relative inline-block whitespace-nowrap text-sky">
            stay in touch
            <HandUnderline class="absolute -bottom-2 left-0 h-4 w-full" color="sky" width={6} />
          </span>
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-white/75">
          Get new posts, projects, and lessons from building AI/ML in public,           plus early access to things I'm making. No spam, ever.
        </p>

        <div class="mx-auto mt-8 max-w-lg text-left">
          <MailerLiteForm group={group} buttonLabel="Subscribe" placeholder="you@example.com" />
          <p class="mt-3 text-center text-xs text-white/50">
            Join the list, unsubscribe anytime.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
