---
import { site, socials } from "../data/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Explore",
    links: [
      { label: "Home", href: "/" },
      { label: "About", href: "/about" },
      { label: "Work With Me", href: "/work" },
      { label: "Projects", href: "/projects" },
    ],
  },
  {
    title: "Content",
    links: [
      { label: "Writing", href: "/writing" },
      { label: "Videos", href: "/videos" },
      { label: "Products", href: "/products" },
      { label: "Medium", href: socials.medium },
    ],
  },
];

const social = [
  { name: "github", href: socials.github, label: "GitHub" },
  { name: "linkedin", href: socials.linkedin, label: "LinkedIn" },
  { name: "medium", href: socials.medium, label: "Medium" },
  { name: "youtube", href: socials.youtube, label: "YouTube" },
  { name: "email", href: socials.email, label: "Email" },
];
---

<footer class="relative mt-10 bg-navy text-white">
  <div class="container-page py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-2.5">
          <span class="grid h-10 w-10 place-items-center rounded-full bg-white font-display text-lg font-semibold text-navy">R</span>
          <span class="font-display text-xl font-semibold">Richel</span>
        </a>
        <p class="mt-4 font-hand text-2xl text-sky">{site.tagline}</p>
        <p class="mt-3 text-sm leading-relaxed text-white/70">
          AI/ML engineer, data scientist, and educator helping businesses,
          researchers, and learners do more with their data.
        </p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-sky">
              {col.title}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-sm text-white/70 transition-colors hover:text-white"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-sky">
          Connect
        </h3>
        <div class="mt-4 flex flex-wrap gap-2.5">
          {
            social.map((s) => (
              <a
                href={s.href}
                target={s.name === "email" ? undefined : "_blank"}
                rel="noopener noreferrer"
                aria-label={s.label}
                class="grid h-11 w-11 place-items-center rounded-full border border-white/15 text-white/80 transition-all hover:-translate-y-0.5 hover:border-sky hover:bg-white/5 hover:text-white"
              >
                <Icon name={s.name} />
              </a>
            ))
          }
        </div>
        <a
          href={socials.email}
          class="mt-5 inline-block text-sm text-white/70 transition-colors hover:text-white"
          >{site.email}</a
        >
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row">
      <p>© {year} {site.name}</p>
      <p>Made with care · Built with Astro</p>
    </div>
  </div>
</footer>
