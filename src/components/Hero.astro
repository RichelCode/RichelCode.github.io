---
import { site, assets, socials } from "../data/site";
import Icon from "./Icon.astro";
import HandUnderline from "./HandUnderline.astro";

const social = [
  { name: "github", href: socials.github, label: "GitHub" },
  { name: "linkedin", href: socials.linkedin, label: "LinkedIn" },
  { name: "youtube", href: socials.youtube, label: "YouTube" },
  { name: "medium", href: socials.medium, label: "Medium" },
];
---

<section class="relative overflow-hidden pt-32 pb-12 sm:pt-40 sm:pb-16">
  <!-- Soft ambient blobs -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -left-24 top-24 h-96 w-96 rounded-full bg-sky/40 blur-3xl"></div>
    <div class="absolute right-[-6rem] top-40 h-80 w-80 rounded-full bg-gold/15 blur-3xl"></div>
  </div>

  <div class="container-page">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <!-- Greeting -->
      <div class="order-2 lg:order-1">
        <span class="reveal pill mb-6">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue/60"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-blue"></span>
          </span>
          Available for consulting & collaborations
        </span>

        <h1 class="reveal text-4xl font-semibold leading-[1.05] text-navy sm:text-5xl md:text-6xl" data-delay="60">
          <span class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <span>Hello there,</span>
            <!-- small cute GIF beside the greeting (graceful fallback until provided) -->
            <img
              src={assets.helloGif}
              alt="Waving hello"
              class="inline-block h-12 w-12 rounded-2xl object-cover sm:h-14 sm:w-14"
              onerror="this.replaceWith(Object.assign(document.createElement('span'),{textContent:'👋',className:'text-4xl sm:text-5xl'}))"
            />
          </span>
          <span class="mt-1 block">
            I'm
            <span class="relative ml-1 inline-block text-blue">
              {site.firstName}
              <HandUnderline class="absolute -bottom-3 left-0 h-5 w-full" color="blue" width={7} />
            </span>
          </span>
        </h1>

        <p class="reveal mt-9 max-w-md text-lg leading-relaxed text-muted" data-delay="160">
          {site.valueProp}
        </p>

        <div class="reveal mt-8 flex flex-wrap items-center gap-3" data-delay="220">
          <a href="/contact" class="btn btn-primary">
            Work with me <Icon name="arrowRight" class="h-4 w-4" />
          </a>
          <a href="/projects" class="btn btn-secondary">View my work</a>
        </div>

        <div class="reveal mt-8 flex items-center gap-4" data-delay="280">
          <span class="font-hand text-xl text-blue">find me here</span>
          <div class="flex gap-1.5">
            {
              social.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="grid h-10 w-10 place-items-center rounded-full text-muted transition-colors hover:bg-sky-soft hover:text-blue"
                >
                  <Icon name={s.name} />
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Photo -->
      <div class="reveal order-1 lg:order-2" data-delay="120">
        <div class="relative mx-auto max-w-sm lg:max-w-md">
          <!-- warm rounded frame with subtle tilt -->
          <div class="absolute inset-0 -rotate-3 rounded-[2.5rem] bg-navy/90"></div>
          <div class="absolute inset-0 rotate-2 rounded-[2.5rem] border-2 border-sky"></div>
          <div class="relative overflow-hidden rounded-[2.5rem] border-4 border-white bg-sky-soft shadow-[var(--shadow-lift)]">
            <img
              src={assets.headshot}
              alt={`Portrait of ${site.name}`}
              class="aspect-[5/6] w-full object-cover"
              onerror="this.src='/images/headshot-placeholder.svg'"
            />
          </div>

          <!-- floating brand badge -->
          <div class="absolute -bottom-5 -left-4 animate-float rounded-2xl border border-border bg-white px-4 py-3 shadow-[var(--shadow-soft)]">
            <p class="font-hand text-2xl leading-none text-blue">{site.tagline}</p>
          </div>
          <div class="absolute -right-3 top-6 rotate-6 rounded-full bg-gold px-3 py-1.5 text-xs font-semibold text-[#3d2a06] shadow-[var(--shadow-soft)]">
            AI / ML
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
