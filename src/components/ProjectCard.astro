---
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  delay?: number;
}
const { project: p, delay = 0 } = Astro.props;
---

<article class="reveal card card-hover group flex flex-col overflow-hidden" data-delay={`${delay}`}>
  <!-- Media / demo (your file if provided, else a friendly placeholder) -->
  <div class="relative aspect-[16/9] overflow-hidden border-b border-border bg-sky-soft">
    {
      p.media ? (
        p.media.type === "video" ? (
          <video class="h-full w-full object-cover" autoplay muted loop playsinline preload="metadata" poster={p.media.poster} src={p.media.src} />
        ) : (
          <img class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" src={p.media.src} alt={p.media.alt ?? p.title} loading="lazy" />
        )
      ) : (
        <div class="absolute inset-0 grid place-items-center">
          <div class="absolute inset-0 opacity-50" style="background-image: radial-gradient(#9FC7EC 1.4px, transparent 1.4px); background-size: 22px 22px;" />
          <div class="relative flex flex-col items-center gap-3 text-center">
            <span class="grid h-14 w-14 place-items-center rounded-full bg-navy text-white">
              <Icon name="play" class="h-6 w-6" />
            </span>
            <span class="font-hand text-xl text-blue">demo coming soon</span>
          </div>
        </div>
      )
    }
    <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-wider text-blue backdrop-blur">
      {p.category}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-7">
    <h3 class="font-display text-xl font-semibold text-navy sm:text-2xl">{p.title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-muted">{p.description}</p>

    <p class="mt-4 rounded-2xl bg-sky-soft px-4 py-3 text-sm font-medium text-navy">{p.impact}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {p.stack.map((t) => <span class="chip">{t}</span>)}
    </div>

    <div class="mt-auto flex flex-wrap items-center gap-5 pt-6">
      {
        p.demoUrl ? (
          <a href={p.demoUrl} target="_blank" rel="noopener noreferrer" class="link-arrow text-sm">
            Watch demo <Icon name="arrowUpRight" class="h-4 w-4" />
          </a>
        ) : (
          <span class="text-sm text-muted">Demo coming soon</span>
        )
      }
      {
        p.repoUrl && (
          <a href={p.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-blue">
            <Icon name="github" class="h-4 w-4" /> Code
          </a>
        )
      }
    </div>
  </div>
</article>
